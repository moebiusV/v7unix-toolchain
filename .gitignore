# build artifacts
*.o

# built host binaries (all under modern/)
modern/cpp/cpp
modern/cc/cc
modern/cc/c0/c0
modern/cc/c1/c1
modern/c2/c2
modern/as/as
modern/as/as2
modern/ld/ld

# bison/yacc-generated parser (from modern/cpp/cpy.y)
modern/cpp/cpy.c
modern/cpp/y.tab.c
modern/cpp/y.tab.h

# c2 generated source (modern/c2: build-host.py -> c2.host.c)
modern/c2/c2.host.c

# autotools: build artifacts generated by ./configure (NOT shipped)
Makefile
!dist/*/Makefile
config.h
config.log
config.status
stamp-h1
.deps/
autom4te.cache/
aclocal.m4

# NB: configure, Makefile.in, config.h.in and build-aux/ are TRACKED — the
# one exception to the no-generated-artifacts rule — so ./configure && make
# works without autotools.

# editor/autoconf backups and dist tarballs
*~
*.tar.gz

# keep the V7 reference .o files (orig/lib)
!orig/lib/*.o
