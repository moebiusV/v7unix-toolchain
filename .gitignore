# build artifacts
*.o

# built host binaries (all under modern/usr/src/cmd/)
modern/usr/src/cmd/cc
modern/usr/src/cmd/ld
modern/usr/src/cmd/cp
modern/usr/src/cmd/mv
modern/usr/src/cmd/rm
modern/usr/src/cmd/cmp
modern/usr/src/cmd/ar
modern/usr/src/cmd/c/c0
modern/usr/src/cmd/c/c1
modern/usr/src/cmd/c/c2
modern/usr/src/cmd/c/cvopt
modern/usr/src/cmd/as/as
modern/usr/src/cmd/as/as2
modern/usr/src/cmd/cpp/cpp
modern/usr/src/cmd/make/make
modern/usr/src/cmd/yacc/yacc
modern/usr/src/cmd/sh/sh

# bison/yacc-generated parser (from modern/usr/src/cmd/cpp/cpy.y)
modern/usr/src/cmd/cpp/cpy.c
modern/usr/src/cmd/cpp/y.tab.c
modern/usr/src/cmd/cpp/y.tab.h

# bison-generated parser (from modern/usr/src/cmd/make/gram.y)
modern/usr/src/cmd/make/gram.c
modern/usr/src/cmd/make/gram.h
modern/usr/src/cmd/make/y.tab.c
modern/usr/src/cmd/make/y.tab.h

# c2 generated source (modern/usr/src/cmd/c: build-host.py -> c2.host.c)
modern/usr/src/cmd/c/c2.host.c

# pcc99 tier: built binaries and library (build output; the source lives in
# pcc99/usr/src and pcc99/usr/include, and tools/build-pcc99.sh regenerates
# pcc99/bin and pcc99/lib).
/pcc99/bin/
/pcc99/lib/

# pcc99 tier: in-place build artifacts left in the c/ source dir by an earlier
# build (build-pcc99.sh now assembles in a scratch dir); regenerated, not source.
pcc99/usr/src/cmd/c/c0
pcc99/usr/src/cmd/c/c1
pcc99/usr/src/cmd/c/c2
pcc99/usr/src/cmd/c/c[0-9][0-9].s
pcc99/usr/src/cmd/c/table.i

# pcc99 tier: yacc-generated parsers where the .y grammar is carried (make);
# cpp carries the pre-generated cpy.c instead (no cpy.y in pcc99), so it's tracked.
pcc99/usr/src/cmd/cpp/y.tab.c
pcc99/usr/src/cmd/cpp/y.tab.h
pcc99/usr/src/cmd/make/gram.c
pcc99/usr/src/cmd/make/gram.h
pcc99/usr/src/cmd/make/y.tab.c
pcc99/usr/src/cmd/make/y.tab.h

# autotools: build artifacts generated by ./configure (NOT shipped)
Makefile
!dist/*/Makefile
config.h
config.log
config.status
stamp-h1
.deps/
autom4te.cache/
aclocal.m4

# NB: configure, Makefile.in, config.h.in and build-aux/ are TRACKED — the
# exceptions to the no-generated-artifacts rule — so ./configure && make
# works without autotools.

# editor/autoconf backups and dist tarballs
*~
*.tar.gz

# keep the V7 reference .o files (orig/lib)
!orig/lib/*.o

# built target library (lib/build-libc.sh) — the V7 reference stays in orig/lib/
/lib/libc.a

# synthetic V7 root for the conformance check (tools/v7check.sh), built on demand
/froot/
