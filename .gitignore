# build artifacts
*.o

# built host binaries (all under modern/usr/src/cmd/)
modern/usr/src/cmd/cc
modern/usr/src/cmd/ld
modern/usr/src/cmd/cp
modern/usr/src/cmd/mv
modern/usr/src/cmd/rm
modern/usr/src/cmd/cmp
modern/usr/src/cmd/ar
modern/usr/src/cmd/c/c0
modern/usr/src/cmd/c/c1
modern/usr/src/cmd/c/c2
modern/usr/src/cmd/c/cvopt
modern/usr/src/cmd/as/as
modern/usr/src/cmd/as/as2
modern/usr/src/cmd/cpp/cpp
modern/usr/src/cmd/make/make
modern/usr/src/cmd/yacc/yacc
