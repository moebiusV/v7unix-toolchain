/*  MANIFEST CONSTANT DEFINITIONS.
 *  These are the HUGE (not MEDIUM) sizes — the host has plenty of memory and
 *  the largest V7 grammar (mip/cgram.y) needs 6461 words of storage, which
 *  MEDIUM (5200) cannot hold.  The 32-bit word packing (WORD32) is assumed:
 *  the host's `int` is 32 bits, so lookahead sets pack 32 bits per word and
 *  `TBITSET` is (32+NTERMS)/32. */

enum {
	/* base of nonterminal internal numbers */
	NTBASE = 010000,

	/* internal codes for error and accept actions */
	ERRCODE = 8190,
	ACCEPTCODE = 8191,

	/* sizes and limits (HUGE) */
	ACTSIZE = 12000,
	MEMSIZE = 12000,
	NSTATES = 750,
	NTERMS = 127,
	NPROD = 600,
	NNONTERM = 300,
	TEMPSIZE = 1200,
	CNAMSZ = 5000,
	LSETSIZE = 600,
	WSETSIZE = 350,

	NAMESIZE = 50,
	NTYPES = 63,

	/* associativities */
	NOASC = 0,
	LASC = 1,
	RASC = 2,
	BASC = 3,

	/* flags for state generation */
	DONE = 0,
	MUSTDO = 1,
	MUSTLOOKAHEAD = 2,

	/* flags for a rule having an action, and being reduced */
	ACTFLAG = 04,
	REDFLAG = 010,

	/* output parser flags */
	YYFLAG1 = (-1000),
};

/* 32-bit word size: lookahead sets pack 32 bits per word, so the bit-index
 * macros become real functions.  (The 16-bit V7 path is gone — the host's
 * int is 32 bits.) */

#define TBITSET ((32+NTERMS)/32)

/* BIT() in v7 */ static inline int bit(int *a, int i) { return a[i>>5] & (1 << (i & 037)); }
/* SETBIT() in v7 */ static inline void setbit(int *a, int i) { a[i>>5] |= (1 << (i & 037)); }
/* NWORDS() in v7 */ static inline int nwords(int n) { return (n + 32) / 32; }

/* associativity / precedence / type accessors and setters */

/* ASSOC() in v7 */ static inline int assoc(int i) { return i & 03; }
/* PLEVEL() in v7 */ static inline int plevel(int i) { return (i >> 4) & 077; }
/* TYPE() in v7 */ static inline int toktype(int i) { return (i >> 10) & 077; }

/* SETASC() in v7 */ static inline void setasc(int *i, int j) { *i |= j; }
/* SETPLEV() in v7 */ static inline void setplev(int *i, int j) { *i |= (j << 4); }
/* SETTYPE() in v7 */ static inline void settype(int *i, int j) { *i |= (j << 10); }

